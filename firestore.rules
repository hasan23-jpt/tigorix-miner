rules_version = '2';
// Tigorix — the server talks to Firestore over the REST API with the project
// API key, so these rules must permit that access. All app logic still runs
// server-side; the client never calls Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}