rules_version = '2';
// Tigorix — all game state is written exclusively by the server (Firestore REST
// with a service account, which bypasses these rules). Client SDK access is
// fully denied so balances, tasks, referrals and withdrawals cannot be forged.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}